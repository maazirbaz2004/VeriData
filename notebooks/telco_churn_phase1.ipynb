   "source": [
    "import json\n",
    "from pathlib import Path\n",
    "import pandas as pd\n",
    "from IPython.display import Image, Markdown, display\n",
    "\n",
    "DATASET = 'telco_churn'\n",
    "OUT_DIR = Path('..') / 'outputs' / DATASET\n",
    "CLEAN_CSV = Path('..') / 'data' / 'cleaned' / f'{DATASET}_cleaned.csv'\n",
    "\n",
    "if OUT_DIR.exists():\n",
    "    prof = json.loads((OUT_DIR / 'profile.json').read_text(encoding='utf-8'))\n",
    "    display(pd.DataFrame(prof['columns'])[['name', 'raw_dtype', 'semantic_type', 'pct_missing', 'n_unique', 'semantic_type_reason']])\n",
    "    display(Markdown((OUT_DIR / 'cleaning_log.md').read_text(encoding='utf-8')))\n",
    "    display(Markdown((OUT_DIR / 'scaling_report.md').read_text(encoding='utf-8')))\n",
    "else:\n",
    "    print(f'Run `ads run --input data/raw/telco_churn/WA_Fn-UseC_-Telco-Customer-Churn.csv --name telco_churn` to populate {OUT_DIR}.')"
   ]
