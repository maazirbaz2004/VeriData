# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Secrets & Environment
.env
.cache/

# Raw data is gitignored (download links & scripts/download_datasets.py provided)
data/raw/*
!data/raw/README.md
data/interim/*
!data/interim/.gitkeep

# Keep cleaned datasets, synthetic benchmarks, and generated EDA outputs/reports for TA review
outputs/*/run.log

# Testing & coverage
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Phase 4 benchmark: generated datasets and per-system results are rebuilt by `veridata bench`;
# summaries (results/*.csv, summary.md), calibration and tuning outputs are kept.
outputs/benchmark/*/*/*__seed*/
outputs/benchmark/*/*/results/*/

# Phase 8 intermediate per-dataset caches (summaries, tables, figures & human_sheets are kept)
outputs/eval/*/*/systems/
outputs/eval/*/*/stage_a_cache/
outputs/eval/e5/cache/
outputs/eval/e7/sessions/
