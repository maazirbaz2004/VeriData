# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Secrets & Environment
.env

# Raw data is gitignored (download links & scripts/download_datasets.py provided)
data/raw/*
!data/raw/README.md
data/interim/*
!data/interim/.gitkeep

# Keep cleaned datasets, synthetic benchmarks, and generated EDA outputs/reports for TA review
outputs/*/run.log

# Testing & coverage
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/
